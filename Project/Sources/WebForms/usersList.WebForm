		"styles": [
			{
				"name": "lighQueryBuilderCss",
				"content": ".builder {\n  background-color: #e4e6eb !important;\n}\n .builder-header {\n  background-color: #e4e6eb !important;\n}\n\n .builder-andOrExcept {\n  background-color: #e4e6eb !important;\n}\n\n .builder-and {\n  border-color: #e4e6eb !important;\n  background-color: #e7f3ff !important;\n}\n\n .builder-or {\n  border-color: #e4e6eb !important;\n  background-color: #e7f3ff !important;\n}\n\n .builder-except {\n  border-color: #e4e6eb !important;\n  background-color: #e7f3ff !important;\n}\n\n .builder-rule {\n background-color: #e7f3ff !important;\n min-width: fit-content !important;\n}\n\n .builder-rule-line {\n background-color: #e7f3ff !important;\n}\n\n .builder-group {\n background-color: #e7f3ff !important;\n min-width: fit-content !important;\n}\n\n .builder-footer {\n  background-color: #e4e6eb !important;\n}\n\n .builder-clear {\n  border-color: #e7f3ff !important;\n}\n\n .builder-apply {\n  background-color: #e7f3ff !important;\n}\n\n .builder-group-container {\n\n}\n\n .builder-and-group,   .builder-or-group {\n  border-color: #e4e6eb !important;\n  background-color: #e7f3ff !important;\n}",
				"parentId": null,
				"id": "YJ9wOJ4R1tsiRU3vGkF3_",
				"scope": "local"
			},
			{
				"name": "darkQueryBuilderCss",
				"content": "/* .builder {\n  background-color: #3e4042 !important;\n}\n\n .builder-header {\n  background-color: #3e4042 !important;\n\tcolor:#2e89ff !important;\n}\n\n .builder-andOrExcept {\n  background-color: #3e4042 !important;\n}\n\n .builder-and {\n  background-color: #2d88ff20 !important;\n\tborder-color:#2e89ff !important;\n}\n\n .builder-or {\n\tborder-color:#2e89ff !important;\n   background-color: #2d88ff20 !important;\n}\n\n .builder-except {\n\tborder-color:#2e89ff !important;\n   background-color: #2d88ff20 !important;\n}\n\n .builder-rule {\n background-color: #2d88ff20 !important;\n min-width: fit-content !important;\n border: solid 2px #2e89ff !important;\n}\n\n .builder-group {\n background-color: #2d88ff20 !important;\n min-width: fit-content !important;\n border: solid 2px #2e89ff !important;\n}\n\n .builder-footer {\n  background-color: #3e4042 !important;\n\tcolor:#2e89ff !important;\n}\n\n .builder-clear {\n\tborder-color:#2e89ff !important;\n}\n\n .builder-apply {\n  background-color: #2d88ff20 !important;\n\tborder: solid 2px #2e89ff !important;\n}\n\n .builder-and-group,   .builder-or-group {\n  border-color: #3e4042 !important;\n  background-color: #2d88ff20 !important;\n} */",
