		"styles": [
			{
				"name": "suggestionIcons",
				"content": "self:has(p span[title=\"On holiday\"])::before {\n\tcontent: \"\\f5ca\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n}\n\nself:has(p span[title=\"Off sick\"])::before {\n\tcontent: \"\\e064\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n}\n\nself:has(p span[title=\"Working from home\"])::before {\n\tcontent: \"\\e066\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n}\n\nself:has(p span[title=\"Traveling\"])::before {\n\tcontent:  \"\\f072\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n}\n\nself:has(p span[title=\"On a coffee break\"])::before {\n\tcontent:  \"\\f7b6\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n}",
				"parentId": null,
				"id": "-GtD0Qw2iVRPUBr0HcSa-"
			},
			{
				"name": "isReadNotif",
				"content": "self:has(p > span[title=\"true\"]){\n\tdisplay: none !important;\n}",
				"parentId": null,
				"id": "LougnX-i_GGpZQl9HFXlj"
			},
			{
				"name": "notifRead",
				"content": ".notifContent :has(p > span[title=true]){\n\tdisplay: none !important;\n\tbackground-color: red !important;\n}",
				"parentId": null,
				"id": "WtFnYVJBaRaNbctKPg-aB"
			},
			{
				"name": "notifContent",
				"content": "self {\n\n}",
				"parentId": null,
				"id": "U4PzATjQ3phlcnk2eUHZC"
			},
			{
				"name": "editorContent",
				"content": "self span {\n\tdisplay: -webkit-box;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    -webkit-line-clamp: 1;\n\ttext-overflow: ellipsis;\n    max-width: 100%;\n}",
				"parentId": null,
				"id": "gN9kSU-0JzRu8UnoOGpT_"
			},
			{
				"name": "pinnedMessageCss",
				"content": "self:has(p > span[title=true]){\n\tdisplay: flex !important;\n}",
				"parentId": null,
				"id": "5XMZIRz1p3q2-oaOmLQiX"
			},
			{
				"name": "notifIcon",
				"content": "self:has(p span[title=\"New message!\"]) {\n\tcolor: #1763cf !important;\n}\nself:has(p span[title=\"New post!\"]) {\n\tcolor: #bcc0c4 !important;\n}\nself:has(p span[title=\"New follow!\"]) {\n\tcolor: #31a24c !important;\n}\nself:has(p span[title=\"New comment!\"]) {\n\tcolor: #606770 !important;\n}\nself:has(p span[title=\"New token!\"]) {\n\tcolor: #f78e3c  !important;\n}\nself:has(p span[title=\"New message!\"])::before {\n\tcontent: \"\\f0e0\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n\tcolor:#1763cf;\n}\nself:has(p span[title=\"New post!\"])::before {\n\tcontent: \"\\f1ea\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n\tcolor: #bcc0c4;\n}\nself:has(p span[title=\"New comment!\"])::before {\n\tcontent: \"\\f4ad\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n\tcolor: #606770;\n}\nself:has(p span[title=\"New follow!\"])::before {\n\tcontent: \"\\f234\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n\tcolor: #31a24c;\n}\nself:has(p span[title=\"New token!\"])::before {\n\tcontent: \"\\f013\";\n\t font-family: FontAwesome;\n    font-style: normal;\n    font-weight: normal;\n\tcolor: #f78e3c ;\n}",
				"parentId": null,
				"id": "1QbNp8b9o_EllfKi0kw7R"
			},
			{
				"name": "accordionCSS",
				"content": "self .accordion-chevron{\n\tpadding: 0px;\n}\n\nself .accordion-chevron:hover{\n\tcolor: #74a4f2;\n}",
				"parentId": null,
				"id": "Wk3TXAejhrMbrID4dOAPm"
			}
		],
